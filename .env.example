# Optional. Without these the app runs in demo mode (data saved in the browser).
# Create a project at supabase.com, run supabase/schema.sql, then copy the values
# from Project Settings → API. The anon key is public by design; Row Level
# Security is what protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
